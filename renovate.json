{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "enabledManagers": [
    "pep621",
    "pip_requirements",
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "automerge": false,
  "dependencyDashboard": {
    "enabled": false
  },
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python minor and patch dependencies"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python",
        "docker.io/library/python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "matchPackageNames": [
        "pytest"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "Pytest patch updates",
      "automerge": true,
      "rebaseWhen": "behind-base-branch",
      "prPriority": 5
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "docker.io/library/python"
      ],
      "matchCurrentValue": "3.12-slim",
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "rebaseWhen": "behind-base-branch",
      "prPriority": 5
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/renovate-config\\.yml$/"
      ],
      "matchStrings": [
        "--package=renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate"
    }
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": false,
  "platformAutomerge": false,
  "automergeType": "pr",
  "ignoreTests": false,
  "vulnerabilityAlerts": {
    "automerge": false,
    "minimumReleaseAge": "3 days",
    "minimumReleaseAgeBehaviour": "timestamp-required"
  }
}
